_FONTS = {}


def font(size, bold=True):
    key = (size, bold)
    if key not in _FONTS:
        f = None
        for p in (BOLD_PATHS if bold else REG_PATHS):
            if os.path.exists(p):
                f = ImageFont.truetype(p, size)
                break
        _FONTS[key] = f or ImageFont.load_default()
    return _FONTS[key]


def clamp(x, a=0.0, b=1.0):
    return max(a, min(b, x))


def ease_out_cubic(x):
    return 1 - (1 - clamp(x)) ** 3


def ease_in_cubic(x):
    return clamp(x) ** 3


def ease_out_back(x):
    x = clamp(x)
    c1 = 1.70158
    c3 = c1 + 1
    return 1 + c3 * (x - 1) ** 3 + c1 * (x - 1) ** 2


def wrap(draw, text, f, maxw):
    lines, cur = [], ""
    for word in text.split():
        t = (cur + " " + word).strip()
        if draw.textlength(t, font=f) <= maxw:
            cur = t
        else:
            if cur:
                lines.append(cur)
            cur = word
    if cur:
        lines.append(cur)
    return lines


def text_block(draw, cx, y, text, f, fill, maxw, gap=1.18, shadow=None):
    """Draw centred, wrapped text. Returns the y below the block."""
    for line in wrap(draw, text, f, maxw):
        w = draw.textlength(line, font=f)
        if shadow:
            draw.text((cx - w / 2 + 4, y + 5), line, font=f, fill=shadow)
        draw.text((cx - w / 2, y), line, font=f, fill=fill)
        y += f.size * gap
    return y


def with_alpha(img, a):
    if a >= 0.999:
        return img
    r, g, b, al = img.split()
    al = al.point(lambda p: int(p * a))
    return Image.merge("RGBA", (r, g, b, al))


