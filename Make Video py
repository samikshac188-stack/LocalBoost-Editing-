def make_base():
    y = np.linspace(0, 1, H, dtype=np.float32)[:, None, None]
    top = np.array((250, 252, 255), np.float32)
    bot = np.array((222, 236, 252), np.float32)
    arr = (top * (1 - y) + bot * y) * np.ones((1, W, 1), np.float32)
    img = Image.fromarray(arr.astype(np.uint8), "RGB")
    blobs = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    d = ImageDraw.Draw(blobs)
    d.ellipse((W - 380, -260, W + 260, 380), fill=ORANGE + (70,))
    d.ellipse((-300, H - 520, 340, H + 120), fill=BLUE + (60,))
    d.ellipse((W - 300, H - 760, W + 200, H - 260), fill=GREEN + (45,))
    blobs = blobs.filter(ImageFilter.GaussianBlur(90))
    img.paste(blobs, (0, 0), blobs)
    return img


BASE = None
FLOATERS = None


def init_background():
    global BASE, FLOATERS
    BASE = make_base()
    spec = [  # diameter, colour, x, y, amp_x, amp_y, speed, phase
        (150, ORANGE, 90, 470, 30, 40, 0.9, 0.0),
        (110, GREEN, 975, 640, 25, 35, 1.1, 1.3),
        (190, BLUE, 985, 1420, 35, 45, 0.7, 2.1),
        (90, RED, 60, 1230, 20, 30, 1.2, 0.7),
        (70, YELLOW, 930, 300, 15, 20, 1.4, 2.8),
        (130, GREEN, 60, 1720, 30, 30, 0.8, 4.0),
        (100, ORANGE, 950, 1800, 25, 30, 1.0, 5.1),
    ]
    FLOATERS = []
    for d, col, x, y, ax, ay, sp, ph in spec:
        FLOATERS.append((sphere(d, col), soft_shadow(int(d * 0.9), int(d * 0.22)),
                         d, x, y, ax, ay, sp, ph))


def base_frame(tg):
    f = BASE.copy()
    for spr, shd, d, x, y, ax, ay, sp, ph in FLOATERS:
        cx = x + ax * math.sin(tg * sp + ph)
        cy = y + ay * math.cos(tg * sp * 0.8 + ph)
        f.paste(shd, (int(cx - shd.width / 2), int(cy + d * 0.55 - shd.height / 2 + 30)), shd)
        f.paste(spr, (int(cx - d / 2), int(cy - d / 2)), spr)
    return f


