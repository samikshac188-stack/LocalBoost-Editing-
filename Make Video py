def tool_scene(idx, tool, dur, t0, top_ui):
    plate, head = top_ui
    acc = ACCENTS[(idx - 1) % len(ACCENTS)]
    w, h = 900, 640
    card, (ox, oy) = make_card(w, h, acc)
    d = ImageDraw.Draw(card)
    cx = ox + w // 2

    # measure content so it sits in the vertical centre of the card
    size = 100
    while True:
        nf = font(size)
        name_lines = wrap(d, tool["n"], nf, 780)
        if len(name_lines) <= 2 or size <= 72:
            break
        size -= 8
    sf = font(42, False)
    sub_lines = wrap(d, tool["sub"], sf, 760)
    chip_f = font(36)
    chip_w = int(d.textlength(tool["cat"], font=chip_f)) + 80
    total = 64 + 40 + len(name_lines) * size * 1.18 + 28 + len(sub_lines) * 42 * 1.3
    y = oy + border_off(h, total)

    d.rounded_rectangle((cx - chip_w // 2, y, cx + chip_w // 2, y + 64), 32, fill=acc)
    d.text((cx, y + 32), tool["cat"], font=chip_f, fill=(255, 255, 255), anchor="mm")
    y += 64 + 40
    y = text_block(d, cx, y, tool["n"], nf, NAVY, 780, gap=1.18)
    y += 28
    text_block(d, cx, y, tool["sub"], sf, GREY, 760, gap=1.3)

    bd = sphere(230, acc)
    bdraw = ImageDraw.Draw(bd, "RGBA")
    bdraw.text((117, 119), str(idx), font=font(130), fill=(0, 0, 0, 80), anchor="mm")
    bdraw.text((115, 115), str(idx), font=font(130), fill=(255, 255, 255, 255), anchor="mm")
    free = pill("100% FREE", GREEN, 380, 88, 48)
    cy = 1090

    def mf(t):
        f = base_frame(t0 + t)
        f.paste(plate, (int(W / 2 - plate.width / 2), int(215 - plate.height / 2)), plate)
        f.paste(head, (0, 330), head)
        ex = clamp((t - (dur - 0.35)) / 0.35)
        xoff = -ease_in_cubic(ex) * (W + 400)
        ang = draw_card(f, card, W / 2, cy, t, xoff=xoff)
        draw_pop(f, bd, 150 - ang * 2.0, cy - 345, t, delay=0.25, bob=10, xoff=xoff)
        draw_pop(f, free, W / 2, 1500, t, delay=0.5, bob=6, xoff=xoff)
        frac = ((idx - 1) + ease_out_cubic(t / 0.6)) / len(TOOLS)
        draw_progress(f, frac, f"{idx} / {len(TOOLS)}")
        return np.array(f)
    return mf


def border_off(h, total):
    return max(40, (h - total) / 2 + 8)


