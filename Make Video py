def sphere(d, color):
    """Shaded 3D sphere sprite (RGBA)."""
    ss = 2
    n = d * ss
    y, x = np.mgrid[0:n, 0:n].astype(np.float32)
    c = (n - 1) / 2
    nx, ny = (x - c) / (n / 2), (y - c) / (n / 2)
    rr = nx ** 2 + ny ** 2
    nz = np.sqrt(np.clip(1 - rr, 0, 1))
    L = np.array([-0.5, -0.6, 0.62], np.float32)
    L /= np.linalg.norm(L)
    diff = np.clip(nx * L[0] + ny * L[1] + nz * L[2], 0, 1)
    spec = diff ** 40 * 0.9
    base = np.array(color, np.float32)
    rgb = base[None, None, :] * (0.40 + 0.75 * diff[..., None]) + 255 * spec[..., None]
    rgb = np.clip(rgb, 0, 255).astype(np.uint8)
    a = np.where(rr <= 1, 255, 0).astype(np.uint8)
    img = Image.fromarray(np.dstack([rgb, a]), "RGBA")
    return img.resize((d, d), Image.LANCZOS)


def soft_shadow(w, h, alpha=70):
    pad = 40
    im = Image.new("RGBA", (w + pad * 2, h + pad * 2), (10, 30, 90, 0))
    ImageDraw.Draw(im).ellipse((pad, pad, pad + w, pad + h), fill=(10, 30, 90, alpha))
    return im.filter(ImageFilter.GaussianBlur(18))


def make_card(w, h, accent, depth=22, radius=60, face=(255, 255, 255),
              border=14, pad=70):
    """Thick rounded 'slab' with extrusion + soft shadow. Returns (sprite, (face_x, face_y))."""
    ss = 2
    cw, ch = w + 2 * pad, h + 2 * pad + depth
    layer = Image.new("RGBA", (cw * ss, ch * ss), (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    dark = tuple(int(c * 0.55) for c in accent)

    def rr(x0, y0, x1, y1, fill):
        d.rounded_rectangle([x0 * ss, y0 * ss, x1 * ss, y1 * ss], radius * ss, fill=fill)

    for i in range(depth, 0, -1):          # extrusion (gives the 3D thickness)
        rr(pad, pad + i, pad + w, pad + h + i, dark)
    if border:
        rr(pad, pad, pad + w, pad + h, accent)
        rr(pad, pad + border, pad + w, pad + h, face)
    else:
        rr(pad, pad, pad + w, pad + h, face)
    layer = layer.resize((cw, ch), Image.LANCZOS)

    sh = Image.new("RGBA", (cw, ch), (10, 30, 90, 0))
    ImageDraw.Draw(sh).rounded_rectangle(
        [pad + 8, pad + depth + 26, pad + w - 8, pad + h + depth + 26],
        radius, fill=(10, 30, 90, 120))
    sh = sh.filter(ImageFilter.GaussianBlur(24))
    return Image.alpha_composite(sh, layer), (pad, pad)


def _coeffs(dst, src):
    A, B = [], []
    for (x, y), (X, Y) in zip(dst, src):
        A.append([x, y, 1, 0, 0, 0, -X * x, -X * y])
        A.append([0, 0, 0, x, y, 1, -Y * x, -Y * y])
        B += [X, Y]
    return np.linalg.solve(np.array(A, float), np.array(B, float))


def tilt(img, ang, dist=2400):
    """Rotate a sprite around its vertical axis with perspective (fake 3D)."""
    if abs(ang) < 0.2:
        return img
    w, h = img.size
    th = math.radians(ang)
    src = [(0, 0), (w, 0), (w, h), (0, h)]
    dst = []
    for x, y in src:
        X, Y = x - w / 2, y - h / 2
        s = dist / (dist + X * math.sin(th))
        dst.append((w / 2 + X * math.cos(th) * s, h / 2 + Y * s))
    return img.transform((w, h), Image.PERSPECTIVE, _coeffs(dst, src), Image.BICUBIC)


# ---------- logo ----------
def load_logo():
    for p in ("logo.png", "logo.webp", "logo.jpg", "logo.jpeg"):
        if os.path.exists(p):
            im = Image.open(p).convert("RGB")
            diff = ImageChops.difference(im, Image.new("RGB", im.size, (255, 255, 255)))
            bbox = diff.convert("L").point(lambda v: 255 if v > 12 else 0).getbbox()
            if bbox:
                im = im.crop(bbox)
            return im.convert("RGBA")
    print("!! logo not found (logo.png / logo.webp) - using text instead")
    im = Image.new("RGBA", (700, 200), (255, 255, 255, 255))
    d = ImageDraw.Draw(im)
    d.text((350, 100), "LocalBoost", font=font(120), fill=NAVY, anchor="mm")
    return im


LOGO = None


def logo_fit(maxw, maxh):
    global LOGO
    if LOGO is None:
        LOGO = load_logo()
    s = min(maxw / LOGO.width, maxh / LOGO.height)
    return LOGO.resize((int(LOGO.width * s), int(LOGO.height * s)), Image.LANCZOS)


def logo_card(w, h, logo_w, logo_h, depth=24, radius=64, border=16):
    card, (ox, oy) = make_card(w, h, BLUE, depth=depth, radius=radius, border=border)
    lg = logo_fit(logo_w, logo_h)
    card.paste(lg, (ox + (w - lg.width) // 2, oy + border // 2 + (h - lg.height) // 2), lg)
    return card


