#  6. ANIMATION HELPERS
# ============================================================
def draw_card(frame, spr, cx, cy, t, amp=8, xoff=0, delay=0.0):
    """Pop-in with spin, then gentle 3D sway + float. Returns current angle."""
    tt = t - delay
    if tt <= 0:
        return -50
    e = ease_out_cubic(tt / 0.6)
    s = ease_out_back(tt / 0.6)
    ang = -50 * (1 - e) + amp * math.sin(1.6 * tt) * e
    if s < 0.03:
        return ang
    im = tilt(spr, ang)
    if abs(s - 1) > 0.005:
        im = im.resize((max(2, int(im.width * s)), max(2, int(im.height * s))), Image.BILINEAR)
    cy2 = cy + 14 * math.sin(tt * 2.1)
    frame.paste(im, (int(cx + xoff - im.width / 2), int(cy2 - im.height / 2)), im)
    return ang


def draw_pop(frame, spr, cx, cy, t, delay=0.0, bob=0.0, speed=2.4, xoff=0):
    tt = t - delay
    if tt <= 0:
        return
    s = ease_out_back(tt / 0.5)
    if s < 0.03:
        return
    im = spr
    if abs(s - 1) > 0.005:
        im = spr.resize((max(2, int(spr.width * s)), max(2, int(spr.height * s))), Image.BILINEAR)
    y = cy + bob * math.sin(tt * speed + delay * 3)
    frame.paste(im, (int(cx + xoff - im.width / 2), int(y - im.height / 2)), im)


def draw_fade_slide(frame, spr, cx, cy, t, delay=0.0, rise=60):
    tt = t - delay
    if tt <= 0:
        return
    e = ease_out_cubic(tt / 0.5)
    im = with_alpha(spr, e)
    frame.paste(im, (int(cx - im.width / 2), int(cy + rise * (1 - e) - im.height / 2)), im)


def draw_progress(frame, frac, label):
    d = ImageDraw.Draw(frame)
    x0, x1, y = 140, 940, 1600
    d.rounded_rectangle((x0, y, x1, y + 26), 13, fill=(214, 225, 242))
    fw = int((x1 - x0) * frac)
    if fw > 26:
        d.rounded_rectangle((x0, y, x0 + fw, y + 26), 13, fill=ORANGE)
    d.text((W // 2, y + 72), label, font=font(40), fill=NAVY, anchor="mm")


