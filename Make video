name: Make Reel
on:
  workflow_dispatch:

jobs:
  render:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - name: Install fonts
        run: sudo apt-get update && sudo apt-get install -y fonts-noto-core
      - name: Install Python packages
        run: pip install -r requirements.txt
      - name: Render video
        run: python make_video.py
      - name: Save video
        uses: actions/upload-artifact@v4
        with:
          name: reel
          path: reel.mp4
